{
  "name": "opencycling.org",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "route:build": "tsx scripts/build-route.ts",
    "route:cities": "node --import tsx scripts/build-city-routes.ts",
    "route:alpe": "tsx scripts/build-alpe.ts",
    "world:audit": "node --import tsx scripts/audit-world.ts",
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "serve out -l 3000",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "worker:build": "node scripts/build-terrain-worker.mjs",
    "prebuild": "npm run worker:build",
    "predev": "npm run worker:build",
    "predev:https": "npm run worker:build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@types/web-bluetooth": "^0.0.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
